# ─────────────────────────────────────────────
# Signs App — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit real secrets to this file.
# ─────────────────────────────────────────────

# Portal (host) remote URL for Module Federation
NEXT_PUBLIC_PORTAL_REMOTE_URL_DEV=http://localhost:3000
NEXT_PUBLIC_PORTAL_REMOTE_URL_PROD=https://portal.yourdomain.com

# Public batch API base URL for direct client requests
# Example: http://34.133.77.6:8080/api/v1/ecs/batch
NEXT_PUBLIC_BATCH_API_BASE_URL=

# Default store identifier used in ECS batch API requests (exposed to client)
NEXT_PUBLIC_DEFAULT_STORE_ID=51

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development
NEXT_PRIVATE_LOCAL_WEBPACK=true

# ECS quick-print preview flow (server-side only)
ECS_PRINT_GATEWAY_URL=<replace-with-ecs-gateway-url>
ECS_PRINT_SERVER_URL=<replace-with-ecs-print-server-url>
ECS_PRINT_PREVIEW_SHOW_URL=<replace-with-ecs-preview-show-url>
ECS_PRINT_TRAY_PRINTER=<replace-with-printer-name>
ECS_PRINT_USERNAME=<replace-with-print-username>
ECS_PRINT_PASSWORD=<replace-with-print-password>
ECS_PRINT_API_TOKEN=<replace-with-print-api-token>

# ECS batch & OAuth API (server-side only — NEVER prefix with NEXT_PUBLIC_)
# OAuth token endpoint
ECS_OAUTH_TOKEN_URL=<replace-with-oauth-token-url>
# OAuth client credentials (rotate immediately if leaked)
ECS_CLIENT_ID=<replace-with-client-id>
ECS_CLIENT_SECRET=<replace-with-client-secret>
# ECS external batch API base URL
ECS_API_BASE_URL=https://qat.np.api.cc-costco.com/whs-sol/costco/signs/v1/ecs

# JWT signing secret — generate with: openssl rand -hex 64
# Must be injected via secrets manager in production, never hardcoded
JWT_SECRET=<generate-with-openssl-rand-hex-64>

ECS_WEB_USERNAME=CostcoWS
ECS_WEB_PASSWORD=dlm429t
ECS_WEB_API_TOKEN=57e1bc49ff598e7495f8b35739848ad2
ECS_PRINT_USERNAME=ECS
ECS_PRINT_SERVER_URL=https://localhost.ecsglobalinc.com:8083
ECS_WEB_SERVER_URL=https://costcotest.ecsglobalinc.com:443
