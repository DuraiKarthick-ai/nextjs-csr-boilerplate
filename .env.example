# ─────────────────────────────────────────────
# Signs App — Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────

# Portal (host) remote URL for Module Federation
NEXT_PUBLIC_PORTAL_REMOTE_URL_DEV=http://localhost:3000
NEXT_PUBLIC_PORTAL_REMOTE_URL_PROD=https://portal.yourdomain.com

# Public batch API base URL for direct client requests
# Example: http://34.133.77.6:8080/api/v1/ecs/batch
NEXT_PUBLIC_BATCH_API_BASE_URL=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development
NEXT_PRIVATE_LOCAL_WEBPACK = true

# ECS quick-print preview flow (server-side only)
ECS_PRINT_GATEWAY_URL=https://localhost.ecsglobalinc.com:8083
ECS_PRINT_SERVER_URL=https://costcotest.ecsglobalinc.com/ecs/
ECS_PRINT_PREVIEW_SHOW_URL=https://costcotest.ecsglobalinc.com/ecs/adhoc-preview-show-data
ECS_PRINT_TRAY_PRINTER=OKI_C9600_F4EEEF
ECS_PRINT_USERNAME=CostcoWS
ECS_PRINT_PASSWORD=dlm429t
ECS_PRINT_API_TOKEN=57e1bc49ff598e7495f8b35739848ad2

# WebSocket print relay
# WS_RELAY_ENABLED and WS_RELAY_TOKEN are read by the app server.
WS_RELAY_ENABLED=true
WS_RELAY_TOKEN=

# Store relay client values (used by scripts/store-relay.js)
RELAY_WS_URL=ws://136.113.73.16/ws/print-relay
RELAY_TOKEN=
STORE_ID=1234
